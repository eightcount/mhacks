{
  "name": "catering-platform-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dashboard": "tsx src/web/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:verify": "tsx src/db/verify.ts",
    "db:summary": "tsx src/db/summary.ts",
    "db:demo": "tsx src/db/demo.ts",
    "agent:backend": "tsx src/agent/internal-api.ts",
    "agent:cli": "python3 -m fetch_agent.local_cli",
    "agent:fetch": "python3 -m fetch_agent.fetch_agent",
    "agent:configure": "node scripts/configure-agent-env.mjs",
    "test:agent": "python3 -m unittest fetch_agent.test_conversation"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.7",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3"
  }
}
