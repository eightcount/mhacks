{
  "name": "catering-platform-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dashboard": "tsx src/web/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:verify": "tsx src/db/verify.ts",
    "db:summary": "tsx src/db/summary.ts",
    "db:demo": "tsx src/db/demo.ts",
    "agent:backend": "tsx src/agent/internal-api.ts",
    "agent:cli": "node scripts/run-agent.mjs cli",
    "agent:fetch": "node scripts/run-agent.mjs fetch",
    "agent:configure": "node scripts/configure-agent-env.mjs",
    "test:agent": "python3 -m unittest fetch_agent.test_conversation fetch_agent.test_fetch_startup fetch_agent.test_caterer fetch_agent.test_caterer_bridge fetch_agent.test_caterer_dates fetch_agent.test_caterer_fetch fetch_agent.test_caterer_forms fetch_agent.test_caterer_cards",
    "caterer:configure": "node scripts/configure-caterer-env.mjs",
    "caterer:backend": "tsx src/agent/caterer-api.ts",
    "caterer:cli": "node scripts/run-caterer.mjs cli",
    "caterer:fetch": "node scripts/run-caterer.mjs fetch",
    "photon:check": "node --import tsx scripts/photon-check.mjs",
    "photon:connect": "node scripts/connect-photon.mjs",
    "photon:start": "node --import tsx scripts/run-photon.mjs",
    "photon:tunnel": "node --import tsx scripts/photon-tunnel.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@spectrum-ts/core": "12.10.1",
    "@spectrum-ts/imessage": "12.10.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.7",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3"
  }
}
